#!/usr/bin/env bash
# Policy: commits carry one author, the person accountable for them. Agent
# use is disclosed in README.md and AGENTS.md, not in the commit trailer.
# This hook enforces that policy by rejecting any commit message that carries
# an AI co-author or generated-by trailer.
set -euo pipefail

msg_file="$1"

# Patterns to reject. Add more if other tools inject trailers in the future.
patterns=(
    'Co-authored-by:[[:space:]]*Cursor[[:space:]]*<cursoragent@cursor.com>'
    'Co-authored-by:[[:space:]]*Claude[[:space:]]*<[^>]*anthropic[^>]*>'
    'Co-authored-by:[[:space:]]*GitHub[[:space:]]*Copilot'
    'Co-authored-by:[[:space:]]*Codex'
    'Co-authored-by:[[:space:]]*Devin'
    'Co-authored-by:[[:space:]]*Aider'
    'Generated-by:[[:space:]]*Cursor'
    'Generated-by:[[:space:]]*Claude'
)

for pat in "${patterns[@]}"; do
    if grep -Eqi -e "$pat" -- "$msg_file"; then
        echo "commit-msg: rejecting commit; message carries an AI-attribution trailer matching: $pat" >&2
        echo "Policy: one author per commit; disclose agent use in README.md and AGENTS.md, not in the commit trailer." >&2
        exit 1
    fi
done

exit 0
